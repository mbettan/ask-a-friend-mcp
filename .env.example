# ==============================================================================
# Ask-a-Friend Consumer MCP — Environment Configuration
# ==============================================================================

# Google Cloud — Target GCP Project for Vertex AI and Model Garden
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=global
ANTHROPIC_REGION=global

# Server & Auth Settings
PORT=8080
HOST=0.0.0.0
AUTH_MODE=api_key                    # Options: iam, api_key, oauth2, none

# REQUIRED for AUTH_MODE=api_key and AUTH_MODE=oauth2 — the server refuses to
# start without it. Generate a strong value: aaf_$(openssl rand -hex 24)
MCP_API_KEY=your-secret-api-key

# Optional. Key material for signing stateless OAuth tokens. Defaults to
# MCP_API_KEY. Set it to rotate token signing (invalidating all issued tokens)
# without rotating the API key that clients already use.
# OAUTH_SIGNING_KEY=

# Ask-a-Friend Server Defaults
ASK_FRIEND_DEFAULT_MODEL=auto
ASK_FRIEND_REQUIRE_APPROVAL=false   # Cloud mode operates autonomously
ASK_FRIEND_USE_CACHE=true
